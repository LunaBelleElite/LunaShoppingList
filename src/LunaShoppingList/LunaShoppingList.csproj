<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>LunaBelleElite</Author>
    <Name>Luna Shopping List</Name>
    <Punchline>Turns a crafting list into a shopping list that says which world to buy each thing on.</Punchline>
    <Description>Open an Artisan or Allagan Tools crafting list, or one you made in the plugin, and it asks Universalis for current prices. It shows where to buy each item and suggests the plan with the fewest worlds for what you're willing to spend.</Description>
    <RepoUrl>https://github.com/LunaBelleElite/LunaShoppingList</RepoUrl>
    <Tags>crafting;artisan;shopping;market;universalis</Tags>
    <RootNamespace>LunaShoppingList</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaShoppingList.Core\LunaShoppingList.Core.csproj" />
  </ItemGroup>
</Project>
