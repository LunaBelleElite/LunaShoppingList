<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the plugin build version (the Dalamud manifest's
         AssemblyVersion and repo.json must equal it). Keep equal to the top
         CHANGELOG.md entry, without -dev: scripts/check-version-sync.sh checks it. -->
    <Version>0.8.0.0</Version>
  </PropertyGroup>
</Project>
