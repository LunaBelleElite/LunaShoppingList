<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Single source of truth for the plugin build version (the Dalamud manifest's
         AssemblyVersion and repo.json must equal it). Keep equal to the top
         CHANGELOG.md entry, without -dev; a version-sync check enforces it. -->
    <Version>1.0.0.0</Version>
  </PropertyGroup>
</Project>
